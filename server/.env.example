# ===== 勤怠システム設定ファイル(コピーして .env という名前で使います) =====
# ※ このファイルの値は他人に見せないでください。.env はGitに入れません。

# サーバーが待ち受けるポート番号
PORT=3000

# QRコードに入れるアドレス(サーバーPCの固定IP)。スマホから開けるアドレスを書きます。
# 例: http://192.168.1.10:3000
BASE_URL=http://192.168.1.10:3000

# 署名用の秘密鍵(setup を実行すると自動で入ります。自分で作る場合は32文字以上のランダムな文字列)
TOKEN_SECRET=
SESSION_SECRET=

# データベースファイルの場所
DB_PATH=./data/kintai.db

# ---- QR打刻 ----
QR_ROTATE_SECONDS=30
QR_TTL_SECONDS=60
# 同じ社員の連続打刻を拒否する秒数
PUNCH_COOLDOWN_SECONDS=60

# ---- ログイン ----
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# ---- バックアップ ----
BACKUP_DIR=./backups
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=30

# 通信内容にHTTPSを使う場合のみ true (使わない場合は false のまま)
COOKIE_SECURE=false
